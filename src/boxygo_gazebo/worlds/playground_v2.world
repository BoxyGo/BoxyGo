<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="playground">
  
    <!--############### from small_city.world ###############-->
    <gui>
      <camera name="user_camera">
        <pose>0 0 30 0 1.57 0</pose>
      </camera>
    </gui>

    <scene>
      <grid>false</grid>
      <origin_visual>false</origin_visual>
      <ambient>0.85 0.85 0.85 1</ambient>
      <sky/>
      <background>0.35 0.35 0.35 1.0</background>
    </scene>

    <physics name='default_physics' default='0' type='ode'>
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>200</real_time_update_rate>
    </physics>

    <light type="directional" name="sun">
      <pose>0 0 1000 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.4</direction>
    </light> 

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>10000</mu>
                <mu2>5000</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>
    </model> 

    <!-- Asphalt base (thin layer, grey) -->
    <model name="asphalt_base">
      <static>true</static>
      <link name="asphalt_link">
        <pose>0 0 -0.01 0 0 0</pose>
        <visual name="asphalt_visual">
          <geometry>
            <box>
              <size>20 20 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <model name="room_walls">
      <static>true</static>

      <!-- obrót całości o -90° (usuń lub ustaw 0, jeśli nie chcesz obrotu) -->
      <pose>-5 1.5 0 0 0 -1.57079632679</pose>

      <link name="walls_link">
        <!-- stałe: thickness=0.2, height=1.0, corridor_width=1.25 -->
        <!-- z = 0.5 bo ściana ma 1.0 m wysokości -->

        <!-- KORYTARZ: górna ściana (wewn. krawędź y=+0.625 => środek y=+0.725) -->
        <visual name="corridor_top_visual">
          <pose>-2.6 0.725 0.5 0 0 0</pose>
          <geometry><box><size>5.2 0.2 1.0</size></box></geometry>
          <material><script><name>Gazebo/Black</name></script></material>
        </visual>
        <collision name="corridor_top_collision">
          <pose>-2.6 0.725 0.5 0 0 0</pose>
          <geometry><box><size>5.2 0.2 1.0</size></box></geometry>
        </collision>

        <!-- KORYTARZ: dolna ściana (wewn. krawędź y=-0.625 => środek y=-0.725) -->
        <visual name="corridor_bottom_visual">
          <pose>-2.6 -0.725 0.5 0 0 0</pose>
          <geometry><box><size>5.2 0.2 1.0</size></box></geometry>
          <material><script><name>Gazebo/Black</name></script></material>
        </visual>
        <collision name="corridor_bottom_collision">
          <pose>-2.6 -0.725 0.5 0 0 0</pose>
          <geometry><box><size>5.2 0.2 1.0</size></box></geometry>
        </collision>

        <!-- KORYTARZ: lewa ścianka zamykająca (wewn. krawędź x=-5 => środek x=-5.1) -->
        <visual name="corridor_left_cap_visual">
          <pose>-5.1 0 0.5 0 0 0</pose>
          <geometry><box><size>0.2 1.45 1.0</size></box></geometry>
          <material><script><name>Gazebo/Black</name></script></material>
        </visual>
        <collision name="corridor_left_cap_collision">
          <pose>-5.1 0 0.5 0 0 0</pose>
          <geometry><box><size>0.2 1.45 1.0</size></box></geometry>
        </collision>

        <!-- POKÓJ: górna ściana (wewn. y=+3.625 => środek y=+3.725) -->
        <visual name="room_top_visual">
          <pose>1.5 3.725 0.5 0 0 0</pose>
          <geometry><box><size>3.2 0.2 1.0</size></box></geometry>
          <material><script><name>Gazebo/Black</name></script></material>
        </visual>
        <collision name="room_top_collision">
          <pose>1.5 3.725 0.5 0 0 0</pose>
          <geometry><box><size>3.2 0.2 1.0</size></box></geometry>
        </collision>

        <!-- POKÓJ: dolna ściana (wewn. y=-3.625 => środek y=-3.725) -->
        <visual name="room_bottom_visual">
          <pose>1.5 -3.725 0.5 0 0 0</pose>
          <geometry><box><size>3.2 0.2 1.0</size></box></geometry>
          <material><script><name>Gazebo/Black</name></script></material>
        </visual>
        <collision name="room_bottom_collision">
          <pose>1.5 -3.725 0.5 0 0 0</pose>
          <geometry><box><size>3.2 0.2 1.0</size></box></geometry>
        </collision>

        <!-- POKÓJ: prawa ściana (wewn. x=3 => środek x=3.1), wysokość 7.25 -->
        <visual name="room_right_visual">
          <pose>3.1 0 0.5 0 0 0</pose>
          <geometry><box><size>0.2 7.45 1.0</size></box></geometry>
          <material><script><name>Gazebo/Black</name></script></material>
        </visual>
        <collision name="room_right_collision">
          <pose>3.1 0 0.5 0 0 0</pose>
          <geometry><box><size>0.2 7.45 1.0</size></box></geometry>
        </collision>

        <!-- POKÓJ: lewa ściana - segment górny (nad wejściem), długość 3m -->
        <visual name="room_left_upper_visual">
          <pose>-0.1 2.125 0.5 0 0 0</pose>
          <geometry><box><size>0.2 3.0 1.0</size></box></geometry>
          <material><script><name>Gazebo/Black</name></script></material>
        </visual>
        <collision name="room_left_upper_collision">
          <pose>-0.1 2.125 0.5 0 0 0</pose>
          <geometry><box><size>0.2 3.0 1.0</size></box></geometry>
        </collision>

        <!-- POKÓJ: lewa ściana - segment dolny (pod wejściem), długość 3m -->
        <visual name="room_left_lower_visual">
          <pose>-0.1 -2.125 0.5 0 0 0</pose>
          <geometry><box><size>0.2 3.0 1.0</size></box></geometry>
          <material><script><name>Gazebo/Black</name></script></material>
        </visual>
        <collision name="room_left_lower_collision">
          <pose>-0.1 -2.125 0.5 0 0 0</pose>
          <geometry><box><size>0.2 3.0 1.0</size></box></geometry>
        </collision>

        <!-- WYSTĘP 1m (wewnętrzna ścianka przy dolnej krawędzi wejścia) -->
        <visual name="lip_1m_visual">
          <pose>0.5 -0.725 0.5 0 0 0</pose>
          <geometry><box><size>1.2 0.2 1.0</size></box></geometry>
          <material><script><name>Gazebo/Black</name></script></material>
        </visual>
        <collision name="lip_1m_collision">
          <pose>0.5 -0.725 0.5 0 0 0</pose>
          <geometry><box><size>1.2 0.2 1.0</size></box></geometry>
        </collision>

      </link>
    </model>


  </world>
</sdf>